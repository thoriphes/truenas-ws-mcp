# TrueNAS WebSocket MCP Server Configuration
#
# Copy this file to .env and fill in your values.

# Required: Your TrueNAS API key (create one at System > API Keys)
TRUENAS_API_KEY=your-api-key-here

# TrueNAS WebSocket URL (default: wss://truenas.local/websocket)
# Use your TrueNAS hostname or IP, e.g.:
#   wss://192.168.1.100/websocket
#   wss://truenas.local/websocket
#   https://truenas.local  (auto-converted to wss://)
TRUENAS_URL=wss://truenas.local/websocket

# SSL verification (default: false — most homelabs use self-signed certs)
TRUENAS_VERIFY_SSL=false

# API call timeout in seconds (default: 30)
TRUENAS_TIMEOUT=30
